  "keyFeatures": [
    "Mine-to-Launch: community earns 95% of token supply by writing funny posts and paying a small USDC fee",
    "Auto-graduation: when 95% of supply is mined, the token automatically opens for trading — no admin action needed",
    "Built-in constant-product AMM (x*y=k): trade tokens without bridging or an external DEX",
    "Fee-seeded liquidity: all USDC mining fees become the initial DEX liquidity pool at graduation",
    "Fully onchain: no backend, no admin keys, no team allocation — all parameters immutable after deploy",
    "Per-wallet cooldown and daily mining cap enforced entirely in smart contracts",
    "Pre-graduation USDC refunds: miners can reclaim fees before a token graduates",
    "Creator Livestream: token creators can broadcast live video directly from the token page",
    "Global Live Feed: real-time activity stream of mines, buys, sells, and graduations across all tokens",
    "Leaderboard & Hall of Fame: track top miners and celebrate graduated tokens",
    "Shareable token cards with rich Open Graph previews for X (Twitter)"
  ],
  "publicApiSurface": [
    "LaunchpadFactory.createToken(name, symbol, imageUri, maxSupply, mineAmount, cooldown, dailyMax, feePerMine)",
    "LaunchpadFactory.getTokenCount() → uint256",
    "LaunchpadFactory.getTokens(from, count) → TokenRecord[]",
    "LaunchpadFactory.getToken(index) → TokenRecord",
    "TokenLauncher.mine(funnyPost) payable",
    "TokenLauncher.buyTokens(minTokensOut) payable",
    "TokenLauncher.sellTokens(tokenAmount, minArcOut)",
    "TokenLauncher.claimRefund()",
    "TokenLauncher.claimableRefund(user) → uint256",
    "TokenLauncher.getMiningProgress() → (mined, total)",
    "TokenLauncher.getTokenPrice() → uint256",
    "TokenLauncher.estimateBuy(tokensOut) → arcIn",
    "TokenLauncher.estimateSell(tokensIn) → arcOut",
    "TokenLauncher.getTimeUntilNextMine(user) → seconds",
    "TokenLauncher.getRemainingDailyAllowance(user) → tokens",
    "Event: ActedFun(user, funnyPost, amount, timestamp)",
    "Event: TokenGraduated(token, tokenReserve, arcReserve, timestamp)",
    "Event: TokensBought(buyer, arcIn, tokensOut, timestamp)",
    "Event: TokensSold(seller, tokensIn, arcOut, timestamp)",
    "Event: ArcRefundClaimed(user, amount, timestamp)",
    "Event: TokenCreated(tokenAddress, launcherAddress, creator, name, symbol, imageUri, maxSupply, feePerMine)"
  ]
